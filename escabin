SCHEMA_VERSION = 1
API_URL = "https://gtfobins.org/api.json"
DATA_DIR = os.environ.get("ESCABIN_HOME") or os.path.join(
    os.path.expanduser("~"), ".local", "share", "escabin"
)
API_PATH = os.path.join(DATA_DIR, "api.json")

SEVERITY = {"critical": 0, "high": 1, "medium": 2}
CONFIDENCE = {"high": 0, "medium": 1, "low": 2}
EXIT_ERROR = 1
EXIT_FINDINGS = 3
MAX_DOWNLOAD = 8 * 1024 * 1024
HTTP_TIMEOUT = 30
FIND_TIMEOUT_FAST = 120
FIND_TIMEOUT_FULL = 900
CAP_TIMEOUT = 180
SUDO_TIMEOUT = 20
SUDO_ASK_TIMEOUT = 300
FUNC_ORDER = [
    "shell", "command", "reverse-shell", "bind-shell", "privilege-escalation",
    "file-write", "file-read", "library-load", "upload", "download", "list",
    "tty", "connector", "sender", "receiver",
]
SHELLISH = {"shell", "command", "reverse-shell", "bind-shell", "privilege-escalation"}
# file-write and file-read are root too: /etc/sudoers.d and /etc/shadow are one step away
SERIOUS = SHELLISH | {"file-write", "file-read"}
TOOL_DIRS = ("/usr/bin", "/bin", "/usr/sbin", "/sbin")

PRUNE_FULL = [
    "/proc", "/sys", "/dev", "/run", "/snap", "/var/lib/docker",
    "/var/lib/containers", "/var/lib/lxcfs", "/var/lib/kubelet",
    "/var/lib/nfs/rpc_pipefs", "/System/Volumes", "/Volumes",
    "/private/var/vm", "/net",
]
NETWORK_FS = {
    "9p", "afs", "ceph", "cifs", "davfs", "fuse.rclone", "fuse.sshfs",
    "glusterfs", "lustre", "ncpfs", "nfs", "nfs4", "smbfs", "sshfs",
}
# SGID grants this group's access, not root; these groups are effectively privileged.
PRIVILEGED_GROUPS = {"root", "wheel", "admin", "shadow", "disk", "docker", "lxd", "sudo"}
RUNAS_NAME = re.compile(r"^[A-Za-z0-9_.][A-Za-z0-9_.-]*$")
SUDO_TAGS = {
    "EXEC", "NOEXEC", "FOLLOW", "NOFOLLOW", "LOG_INPUT", "NOLOG_INPUT",
