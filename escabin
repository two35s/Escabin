def cmd_show(db, ref):
    key = db.canon(ref)
    if not key:
        die(f"'{ref}' not in GTFOBins (try: escabin search {ref})")
    entry = db.ex[key]
    print(bold(safe_text(key)))
    if entry.get("alias"):
        alias = entry["alias"]
        print(dim("alias: " + safe_text(alias if isinstance(alias, str) else ", ".join(alias))))
    if entry.get("comment"):
        print(safe_text(textwrap.fill(clean_md(entry["comment"]), 96)))
    funcs = db.funcs(key)
    if not funcs:
        print("no functions documented (alias only)")
        return
    for fname in db.ordered(funcs):
        print()
        print(bold(safe_text(db.label(fname))))
        for item in funcs[fname]:
            contexts = " ".join(f"[{c}]" for c in (item.get("contexts") or {}))
            print("  " + cyan(safe_text(contexts)))
            base = item.get("code")
            print_code(base, "    ")
            for ctx, over in (item.get("contexts") or {}).items():
                if isinstance(over, dict) and over.get("code") and over["code"] != base:
                    print(dim(f"    {safe_text(ctx)}:"))
                    print_code(over["code"], "      ")
            caps = context_caps(item, "capabilities")
            if caps:
                print(dim("    needs: " + safe_text(", ".join(caps))))
            if item.get("comment"):
                print(dim(safe_text(textwrap.fill(clean_md(item["comment"]), 96,
                                                  initial_indent="    # ",
                                                  subsequent_indent="    # "))))


def cmd_search(db, term, limit):
    needle = term.lower()
    rows = []
    for name in sorted(db.ex):
        matched = []
        for fname, items in db.funcs(name).items():
            hay = db.label(fname) + " " + " ".join(
                (it.get("code") or "") + " " + (it.get("comment") or "") for it in items
            )
            if needle in hay.lower():
                matched.append(fname)
        if needle in name.lower() or matched:
            rows.append((name, db.ordered(set(matched))))
    if not rows:
        print(safe_text(f"no match for '{term}'"))
        return
    for name, funcs in rows[:limit]:
        detail = ", ".join(db.label(f).lower() for f in funcs) if funcs else "name match"
        print(f"{bold(safe_text(name.ljust(26)))} {dim(safe_text(detail))}")
    if len(rows) > limit:
        print(dim(f"... {len(rows) - limit} more (raise -n)"))


# ---------------------------------------------------------------- local scan

def fast_roots():
    if sys.platform == "darwin":
        return [
            "/bin", "/sbin", "/usr/bin", "/usr/sbin", "/usr/libexec",
            "/usr/local/bin", "/usr/local/sbin", "/opt/homebrew/bin", "/opt/homebrew/sbin",
            "/Applications", "/Library", "/System/Applications",
            "/System/Library/CoreServices", "/private/tmp", "/private/var/tmp",
            "/Users/Shared",
        ]
    return [
        "/bin", "/sbin", "/usr/bin", "/usr/sbin", "/usr/libexec",
        "/usr/local/bin", "/usr/local/sbin", "/opt", "/snap/bin",
        "/tmp", "/var/tmp",
    ]


def _timeout_output(exc):
    out = exc.stdout or ""
    if isinstance(out, bytes):
        out = out.decode(errors="surrogateescape")
    return out


def _first_line(text, limit=200):
    for line in (text or "").splitlines():
        line = line.strip()
        if line:
            return line[:limit]
    return ""


def network_mounts(path="/proc/self/mounts"):
    """Mount points of network filesystems, so --full does not hang on them."""
    found = []
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                parts = line.split()
                if len(parts) < 3 or parts[2] not in NETWORK_FS:
                    continue
                mount = (parts[1].replace("\\040", " ").replace("\\011", "\t")
                         .replace("\\134", "\\"))
                if mount != "/":
                    found.append(mount)
    except OSError:
        pass
    return found


def _dedupe_paths(paths):
    unique = {}
    for path in sorted(paths):
        try:
            key = os.path.realpath(path)
        except OSError:
            key = path
        previous = unique.get(key)
        if previous is None:
            unique[key] = path
            continue
        try:
            if (stat.S_ISLNK(os.lstat(previous).st_mode)
                    and not stat.S_ISLNK(os.lstat(path).st_mode)):
                unique[key] = path
        except OSError:
            pass
    return set(unique.values())


def scan_privileged(full):
    """Find SUID and SGID regular files without following symlinks.

    One find traversal covers both bits. Returns partial results on timeout.
    """
    find = system_tool("find")
    result = {"suid": set(), "sgid": set(), "status": "complete",
              "reason": None, "complete": True}
    if not find:
        result.update(status="unavailable", reason="find not installed", complete=False)
        return result

    roots = [root for root in (["/"] if full else fast_roots()) if os.path.isdir(root)]
    if not roots:
        result.update(status="unavailable", reason="no scan roots exist", complete=False)
        return result
    prune = list(PRUNE_FULL) if full else []
    if full:
        prune.extend(network_mounts())
    timeout = FIND_TIMEOUT_FULL if full else FIND_TIMEOUT_FAST

    def one(root):
        args = [find, root]
        for path in prune:
            args += ["-path", path, "-prune", "-o"]
        args += ["-type", "f", "(", "-perm", "-4000", "-o", "-perm", "-2000",
                 ")", "-print0"]
        try:
            proc = subprocess.run(args, capture_output=True, text=True,
                                  timeout=timeout, errors="surrogateescape")
        except subprocess.TimeoutExpired as exc:
            return (_timeout_output(exc).split("\0"), "partial",
                    f"{root}: timed out after {timeout}s")
        except OSError as exc:
            return [], "failed", f"{root}: {exc}"
        lines = [line for line in (proc.stdout or "").split("\0") if line]
        if proc.returncode != 0:
            reason = f"{root}: {_first_line(proc.stderr) or f'find exited {proc.returncode}'}"
            return lines, ("partial" if lines else "failed"), reason
        return lines, "complete", None

    paths = set()
    statuses = []
    reasons = []
    workers = min(8, max(1, len(roots)))
    with ThreadPoolExecutor(max_workers=workers) as pool:
        for found, status, reason in pool.map(one, roots):
            paths.update(found)
            statuses.append(status)
            if reason:
                reasons.append(reason)

    paths = _dedupe_paths(paths)
    stat_errors = 0
    for path in paths:
        try:
            st = os.lstat(path)
        except OSError:
            stat_errors += 1
            continue
        if not stat.S_ISREG(st.st_mode):
            continue
        if st.st_mode & stat.S_ISUID:
            result["suid"].add(path)
        if st.st_mode & stat.S_ISGID:
            result["sgid"].add(path)

    if "failed" in statuses:
        status = "failed" if not paths else "partial"
    elif "partial" in statuses:
        status = "partial"
    else:
        status = "complete"
    if stat_errors:
        if status == "complete":
            status = "partial"
        reasons.append(f"could not stat {stat_errors} result(s)")
    if status != "complete":
        result["status"] = status
        result["reason"] = "; ".join(dict.fromkeys(reasons)) or "scan did not complete"
        result["complete"] = False
    return result


def parse_getcap(out):
    caps = {}
    for line in (out or "").splitlines():
        parts = line.strip().rsplit(None, 1)
        if len(parts) != 2:
            continue
        path, attrs = parts
        if not path or "=" not in attrs:
            continue
        names = attrs.split("=", 1)[0]
        caps[path] = {name for name in names.split(",") if name}
        if not caps[path]:
            del caps[path]
    return caps


def scan_caps():
    exe = system_tool("getcap")
    if not exe:
        return {"caps": {}, "status": "unavailable",
                "reason": "getcap not installed", "checked": False}
    try:
        proc = subprocess.run([exe, "-r", "/"], capture_output=True, text=True,
                              timeout=CAP_TIMEOUT, errors="surrogateescape")
    except subprocess.TimeoutExpired as exc:
        caps = parse_getcap(_timeout_output(exc))
        return {"caps": caps, "status": "partial" if caps else "failed",
                "reason": "getcap timed out; results incomplete", "checked": False}
    except OSError as exc:
        return {"caps": {}, "status": "failed",
                "reason": f"getcap failed: {exc}", "checked": False}
    caps = parse_getcap(proc.stdout)
    if proc.returncode != 0:
        reason = _first_line(proc.stderr) or f"getcap exited {proc.returncode}"
        return {"caps": caps, "status": "partial" if caps else "failed",
                "reason": reason, "checked": False}
    return {"caps": caps, "status": "complete", "reason": None, "checked": True}


def _split_specs(text):
    """Split a sudo Cmnd_Spec_List on commas outside quotes and a leading runas."""
    specs = []
    buf = []
    quote = None
    runas_depth = 0
    i = 0
    while i < len(text):
        ch = text[i]
        if ch == "\\" and i + 1 < len(text):
            buf.append(ch)
            buf.append(text[i + 1])
            i += 2
            continue
        if quote:
            buf.append(ch)
            if ch == quote:
                quote = None
            i += 1
            continue
        if ch in "'\"":
            quote = ch
            buf.append(ch)
            i += 1
            continue
        if runas_depth:
            buf.append(ch)
            if ch == "(":
                runas_depth += 1
            elif ch == ")":
                runas_depth -= 1
            i += 1
            continue
        if ch == "(" and not "".join(buf).strip():
            runas_depth = 1
            buf.append(ch)
            i += 1
            continue
        if ch == ",":
            specs.append("".join(buf))
            buf = []
            i += 1
            continue
        buf.append(ch)
        i += 1
    specs.append("".join(buf))
    return specs


def _split_command(text):
    """Split a sudo command spec into path and the exact argument tail."""
    out = []
    quote = None
    i = 0
    while i < len(text):
        ch = text[i]
        if ch == "\\" and i + 1 < len(text):
            out.append(text[i + 1])
            i += 2
            continue
        if quote:
            if ch == quote:
                quote = None
            else:
                out.append(ch)
            i += 1
            continue
        if ch in "'\"":
            quote = ch
            i += 1
            continue
        if ch in " \t":
            break
        out.append(ch)
        i += 1
    return "".join(out), text[i:].strip()


def parse_sudo(out):
    chunks = []
    for raw in (out or "").splitlines():
        line = raw.strip()
        if not line:
            continue
        if line.startswith("("):
            chunks.append(line)
        elif chunks and raw[:1] in (" ", "\t"):
            chunks[-1] += " " + line

    rules = []
    for chunk in chunks:
        parsed = re.match(r"\(([^)]*)\)\s*(.*)", chunk)
        if not parsed:
            continue
        runas, body = parsed.group(1).strip(), parsed.group(2)
        nopasswd = False
        for raw_spec in _split_specs(body):
            spec = raw_spec.strip()
            if not spec:
                continue
            override = re.match(r"\(([^)]*)\)\s*(.*)", spec)
            if override:
                runas, spec = override.group(1).strip(), override.group(2).strip()
            original = spec
            while True:
                tag = re.match(r"^([A-Za-z_][A-Za-z0-9_]*)\s*:\s*(.*)$", spec)
                if not tag:
                    break
                name = tag.group(1).upper()
                if name not in SUDO_TAGS:
                    break
                if name == "NOPASSWD":
                    nopasswd = True
                elif name == "PASSWD":
                    nopasswd = False
                spec = tag.group(2).strip()
            if not spec or spec.startswith("!"):
                continue
            permitted = spec
            common = {"runas": runas, "nopasswd": nopasswd, "raw": chunk,
                      "spec": original, "permitted": permitted}
            if spec.upper() == "ALL":
                rules.append(dict(common, all=True, path=None, args="", manual=False))
                continue
            manual = False
            reason = ""
            path = None
            args = ""
            if spec.startswith("/"):
                path, args = _split_command(spec)
                if not path:
                    manual, reason = True, "empty command path"
                elif "*" in path or "?" in path or "[" in path:
                    manual, reason = True, "wildcard command path"
                elif path.endswith("/"):
                    manual, reason = True, "directory command path"
            else:
                manual, reason = True, "unrecognised sudo command specification"
            rules.append(dict(common, all=False, path=path, args=args,
                              manual=manual, reason=reason))
    return rules


def scan_sudo(ask=False):
    exe = system_tool("sudo")
    if not exe:
        return {"ok": False, "rules": [], "error": "sudo not installed",
                "status": "unavailable"}
    args = [exe, "-l"] if ask else [exe, "-n", "-l"]
    try:
        if ask:
            proc = subprocess.run(args, stdout=subprocess.PIPE, text=True,
                                  timeout=SUDO_ASK_TIMEOUT, errors="surrogateescape")
        else:
            proc = subprocess.run(args, capture_output=True, text=True,
                                  timeout=SUDO_TIMEOUT, errors="surrogateescape")
    except subprocess.TimeoutExpired:
        return {"ok": False, "rules": [],
                "error": "sudo -l timed out", "status": "failed"}
    except OSError as exc:
        return {"ok": False, "rules": [],
                "error": f"sudo -l failed: {exc}", "status": "failed"}
    out = proc.stdout or ""
    if proc.returncode != 0:
        combined = (out + "\n" + (proc.stderr or "")).lower()
        if not ask and any(word in combined for word in
                           ("password", "askpass", "no tty", "terminal is required")):
            error = "a password is required (rerun with --ask-sudo)"
            status = "skipped"
        elif any(word in combined for word in
                 ("not permitted", "not allowed", "may not run sudo")):
            error = "not permitted"
            status = "skipped"
        else:
            error = f"sudo -l failed (exit {proc.returncode})"
            detail = _first_line(proc.stderr)
            if detail:
                error += f": {detail}"
            status = "failed"
        return {"ok": False, "rules": [], "error": f"sudo: {error}", "status": status}
    return {"ok": True, "rules": parse_sudo(out), "error": None, "status": "complete"}


def matching(db, path, ctx, have_caps=None):
    key = db.canon(path)
    if not key:
        return None, []
    out = []
    for fname, items in db.funcs(key).items():
        for item in items:
            if ctx not in (item.get("contexts") or {}):
                continue
            if ctx == "capabilities" and have_caps is not None:
                need = context_caps(item, ctx)
                if need and not {c.lower() for c in need} <= {c.lower() for c in have_caps}:
                    continue
            code = context_code(item, ctx)
            if code:
                out.append((fname, code))
            break
    out.sort(key=lambda pair: (FUNC_ORDER.index(pair[0]) if pair[0] in FUNC_ORDER else 99, pair[0]))
    return key, out


def runas_users(runas):
    users = str(runas or "root").split(":", 1)[0]
    return [user.strip() for user in users.split(",") if user.strip()]


def runas_user(rule):
    users = runas_users(rule.get("runas"))
    return users[0] if users else ""


def is_root_runas(runas):
    spec = str(runas or "root").split(":", 1)[0]
    return any(user.strip().upper() == "ALL" or user.strip() == "root"
               for user in spec.split(",") if user.strip())


def writable_by_us(st_mode, euid, can_write):
    # os.access() is true for root on almost everything, so when running as
    # root use group/other write bits: they mean some account could replace it.
    if euid == 0:
        return bool(st_mode & 0o022)
    return bool(can_write)


def make_finding(severity, vector, title, detail, confidence, evidence,
                 command=None, functions=None, manual_review=False):
    if severity not in SEVERITY:
        raise ValueError(f"bad severity: {severity}")
    if confidence not in CONFIDENCE:
        raise ValueError(f"bad confidence: {confidence}")
    return {
        "severity": severity,
        "confidence": confidence,
        "exploitability": "unverified",
        "vector": vector,
        "title": title,
        "detail": detail,
        "command": command,
        "functions": functions or [],
        "manual_review": bool(manual_review),
        "evidence": evidence,
    }


def check_exit_code(findings, fail_on):
    if not fail_on:
        return 0
    threshold = SEVERITY[fail_on]
    return EXIT_FINDINGS if any(SEVERITY[f["severity"]] <= threshold
                                for f in findings) else 0


def _id_name(table, ident, fallback):
    try:
        return table(ident)
    except (KeyError, OSError):
        return str(fallback)


def file_evidence(path, st, check, complete, **extra):
    evidence = {
        "check": check,
        "path": path,
        "owner": _id_name(lambda uid: pwd.getpwuid(uid).pw_name, st.st_uid, st.st_uid),
        "group": _id_name(lambda gid: grp.getgrgid(gid).gr_name, st.st_gid, st.st_gid),
        "mode": format(stat.S_IMODE(st.st_mode), "04o"),
        "setuid": bool(st.st_mode & stat.S_ISUID),
        "setgid": bool(st.st_mode & stat.S_ISGID),
        "scan_complete": complete,
    }
    evidence.update(extra)
    return evidence


def sudo_prefix(rule):
    """Return (prefix, is_root, manual_runas)."""
    raw = rule.get("runas") or "root"
    if is_root_runas(raw):
        return "sudo ", True, False
    users = runas_users(raw)
    if not users or any(not RUNAS_NAME.match(user) for user in users):
        return "", False, True
    return f"sudo -u {shlex.quote(users[0])} ", False, False


def sudo_evidence(rule, complete, **extra):
    evidence = {
        "check": "sudo",
        "path": rule.get("path"),
        "sudo_rule": {
            "raw": rule.get("raw"),
            "spec": rule.get("spec"),
            "permitted": rule.get("permitted"),
            "runas": rule.get("runas") or "root",
            "nopasswd": bool(rule.get("nopasswd")),
            "arguments": rule.get("args", ""),
        },
        "scan_complete": complete,
    }
    evidence.update(extra)
    return evidence


def evidence_summary(finding):
    e = finding["evidence"]
    parts = []
    if e.get("path"):
        parts.append("path=" + str(e["path"]))
    for key in ("owner", "group"):
        if e.get(key):
            parts.append(f"{key}={e[key]}")
    if e.get("mode"):
        parts.append("mode=" + str(e["mode"]))
    for key in ("setuid", "setgid", "writable"):
        if key in e:
            parts.append(f"{key}={'yes' if e[key] else 'no'}")
    if e.get("capabilities"):
        parts.append("caps=" + ",".join(e["capabilities"]))
    if e.get("sudo_rule"):
        rule = e["sudo_rule"]
        parts.append("runas=" + str(rule.get("runas")))
        parts.append("nopasswd=" + ("yes" if rule.get("nopasswd") else "no"))
        if rule.get("arguments"):
            parts.append("args=" + str(rule["arguments"]))
        parts.append("rule=" + str(rule.get("spec") or rule.get("raw")))
    if e.get("functions"):
        parts.append("gtfobins=" + ",".join(e["functions"]))
    if e.get("scan_complete") is not None:
        parts.append("scan=" + ("complete" if e["scan_complete"] else "incomplete"))
    return "  ".join(parts)


def coverage_summary(coverage):
    parts = []
    for name, check in coverage["checks"].items():
        text = f"{name} {check['status']}"
        if check["status"] in ("complete", "partial"):
            text += f" ({check['count']})"
        parts.append(text)
    return "; ".join(parts)


def cmd_check(db, full, as_json, ask_sudo=False, fail_on=None):
    started = time.time()
    notes = []
    findings = []
    linux = sys.platform.startswith("linux")

    with ThreadPoolExecutor(max_workers=4) as pool:
        sudo_future = pool.submit(scan_sudo, ask_sudo)
        privileged_future = pool.submit(scan_privileged, full)
        caps_future = pool.submit(scan_caps) if linux else None
        sudo = sudo_future.result()
        privileged = privileged_future.result()
        if caps_future:
            caps = caps_future.result()
        else:
            caps = {"caps": {}, "status": "unsupported",
                    "reason": "not supported on this platform", "checked": False}

    suid = privileged["suid"]
    sgid = privileged["sgid"]
    suid_complete = privileged["status"] == "complete"
    cap_status = caps["status"]
    cap_reason = caps["reason"]
    cap_stat_errors = 0

    if not sudo["ok"]:
        notes.append(sudo["error"])
    seen_rules = set()
    for rule in sudo["rules"]:
        prefix, root, manual_runas = sudo_prefix(rule)
        user = runas_user(rule)

        if rule.get("all"):
            dedupe = ("all", rule.get("runas"), rule.get("nopasswd"))
            if dedupe in seen_rules:
                continue
            seen_rules.add(dedupe)
            if root:
                severity, title = "critical", "sudo: unrestricted"
            elif manual_runas:
                severity = "medium"
                title = f"sudo as {rule.get('runas')}: unrestricted (manual review)"
            else:
                severity, title = "high", f"sudo as {user}: unrestricted"
            limitations = ("Based on sudo -l output; aliases, includes and policy details "
                           "were not re-parsed. The rule was not executed.")
            finding = make_finding(
                severity, "sudo", title, "sudo rule: " + rule.get("raw", ""), "high",
                sudo_evidence(rule, sudo["status"] == "complete", functions=[]),
                command=(prefix + "-i") if prefix else None,
                manual_review=manual_runas,
            )
            finding["evidence"].update({
                "risk": ("The rule permits any command with the run-as privileges."
                         if not manual_runas else "The run-as specification needs manual review."),
                "limitations": limitations,
                "remediation": ("Restrict the rule to required commands and users; "
                                "avoid unrestricted ALL; review sudoers changes."),
            })
            findings.append(finding)
            continue

        dedupe = (rule.get("path"), rule.get("args"), rule.get("nopasswd"),
                  rule.get("runas"), rule.get("manual"), rule.get("permitted"))
        if dedupe in seen_rules:
            continue
        seen_rules.add(dedupe)

        if rule.get("manual"):
            finding = make_finding(
                "medium", "sudo",
                f"sudo {rule.get('permitted') or 'rule'} (manual review)",
                f"sudo rule: {rule.get('raw')} - {rule.get('reason') or 'manual review required'}",
                "low", sudo_evidence(rule, sudo["status"] == "complete", functions=[]),
                command=None, manual_review=True,
            )
            finding["evidence"].update({
                "risk": "This sudo command specification could not be mapped safely.",
                "limitations": ("Wildcard, directory, alias or unusual run-as rules are not "
                                "evaluated; there is no evidence of exploitability."),
                "remediation": "Replace broad or unusual rules with exact commands and reviewed arguments.",
            })
            findings.append(finding)
            continue

        if manual_runas:
            finding = make_finding(
                "medium", "sudo",
                f"sudo {rule.get('path')} (manual run-as review)",
                f"sudo rule: {rule.get('raw')} - run-as specification could not be interpreted",
                "low", sudo_evidence(rule, sudo["status"] == "complete",
                                      functions=[], path_exists=os.path.exists(rule.get("path") or "")),
                command=None, manual_review=True,
            )
            finding["evidence"].update({
                "risk": "The rule may allow running the command as an unusual target user or group.",
                "limitations": "The run-as list was not resolved; no privilege claim is made.",
                "remediation": "Use explicit user names in sudoers run-as lists and review the rule.",
            })
            findings.append(finding)
            continue

        if rule.get("args"):
            command = None
            if prefix and rule.get("path"):
                command = prefix + shlex.quote(rule["path"]) + " " + rule["args"]
            finding = make_finding(
                "medium", "sudo",
                f"sudo {rule['path']} (restricted args)"
                + (" (NOPASSWD)" if rule["nopasswd"] else ""),
                f"sudo rule: {rule['raw']} - check manually whether the allowed arguments can be abused",
                "low",
                sudo_evidence(rule, sudo["status"] == "complete",
                              functions=[], path_exists=os.path.exists(rule["path"])),
                command=command, manual_review=True,
            )
            finding["evidence"].update({
                "risk": ("Only the listed command and arguments are permitted; the program "
                         "may still have an escape that matches those arguments."
                         if rule.get("args") else
                         "The rule permits the command only without arguments."),
                "limitations": ("The permitted argument list was not evaluated or executed; "
                                "this is not a verified bypass."),
                "remediation": ("Remove the rule or constrain arguments further; avoid editors, "
                                "interpreters and pagers; review the command's argument handling."),
            })
            findings.append(finding)
            continue

        key, funcs = matching(db, rule["path"], "sudo")
        if not key or not funcs:
            continue
        names = [name for name, _ in funcs]
        exists = os.path.exists(rule["path"])
        severity = ("high" if rule["nopasswd"] and any(name in SERIOUS for name in names)
                    else "medium")
        title = f"sudo {rule['path']}" + (f" as {user}" if not root else "") \
                + (" (NOPASSWD)" if rule["nopasswd"] else "")
        detail = f"sudo rule: {rule['raw']}"
        if not root:
            detail += f"  (runs as {user})"
        limitations = ("GTFOBins documents a technique, not a proof that this version and "
                       "configuration are exploitable; the snippet was not executed.")
        if not exists:
            limitations += " The command path did not exist at scan time."
        finding = make_finding(
            severity, "sudo", title, detail,
            "medium" if exists else "low",
            sudo_evidence(rule, sudo["status"] == "complete", path_exists=exists,
                          functions=names),
            functions=[{"name": name,
                        "code": rewrite_commands(code, key, rule["path"], prefix)}
                       for name, code in funcs],
            manual_review=not exists,
        )
        finding["evidence"].update({
            "risk": (f"The rule runs {rule['path']} as {'root' if root else user}; "
                     "the documented function may provide a shell or file access."),
            "limitations": limitations,
            "remediation": ("Restrict or remove the sudo rule; avoid granting interpreters, "
                            "editors, pagers and file tools; review sudoers regularly."),
        })
        findings.append(finding)

    if privileged["status"] != "complete":
        notes.append(f"SUID/SGID scan {privileged['status']}: {privileged['reason']}")
    if cap_status == "unsupported":
        notes.append("capabilities: not supported on this platform")
    elif cap_status != "complete":
        notes.append(f"capabilities: {cap_reason}")

    unknown = []
    for path in sorted(suid):
        try:
            st = os.lstat(path)
        except OSError:
            continue
        writable = writable_by_us(st.st_mode, os.geteuid(), os.access(path, os.W_OK))
        owner = _id_name(lambda uid: pwd.getpwuid(uid).pw_name, st.st_uid, st.st_uid)
        group = _id_name(lambda gid: grp.getgrgid(gid).gr_name, st.st_gid, st.st_gid)
        mode = format(stat.S_IMODE(st.st_mode), "04o")
        key, funcs = matching(db, path, "suid")
        names = [name for name, _ in funcs]

        if writable:
            severity = "critical" if st.st_uid == 0 else "high"
            target = "root" if st.st_uid == 0 else owner
            finding = make_finding(
                severity, "suid", f"writable SUID binary: {path}",
                f"owner {owner}, group {group}, mode {mode} - writable by the current user",
                "high",
                file_evidence(path, st, "suid", suid_complete,
                              writable=True, functions=names),
                functions=[{"name": name,
                            "code": rewrite_commands(code, key, path)}
                           for name, code in funcs],
            )
            finding["evidence"].update({
                "risk": (f"Anyone who can write this file can replace it and execute code "
                         f"with the privileges of {target}."),
                "limitations": ("Writability was observed; the file was not modified or executed. "
                                "The GTFOBins mapping was not tested."),
                "remediation": (f"Remove the SUID bit (chmod u-s {path}), restore root-owned "
                                "mode 0755, and investigate how the file became writable."),
            })
            findings.append(finding)
            continue

        if not key:
            unknown.append(path)
            continue
        if not funcs:
            continue
        severity = "high" if any(name in SERIOUS for name in names) else "medium"
        finding = make_finding(
            severity, "suid", f"SUID {path}",
            f"owner {owner}, group {group}, mode {mode}",
            "medium",
            file_evidence(path, st, "suid", suid_complete,
                          writable=False, functions=names),
            functions=[{"name": name,
                        "code": rewrite_commands(code, key, path)}
                       for name, code in funcs],
        )
        finding["evidence"].update({
            "risk": (f"{path} runs with elevated privileges ({owner}); GTFOBins documents "
                     "a matching function that may provide a shell or file access."),
            "limitations": ("GTFOBins documents a technique, not proof of exploitability on "
                            "this version and configuration; the snippet was not executed."
                            + ("" if st.st_uid == 0 else f" The file is owned by {owner}, not root.")),
            "remediation": ("Remove the SUID bit if it is not required, update the package, "
                            "and prefer non-privileged alternatives."),
        })
        findings.append(finding)

    for path in sorted(sgid):
        try:
            st = os.lstat(path)
        except OSError:
            continue
        if not writable_by_us(st.st_mode, os.geteuid(), os.access(path, os.W_OK)):
            continue
        owner = _id_name(lambda uid: pwd.getpwuid(uid).pw_name, st.st_uid, st.st_uid)
        group = _id_name(lambda gid: grp.getgrgid(gid).gr_name, st.st_gid, st.st_gid)
        mode = format(stat.S_IMODE(st.st_mode), "04o")
        privileged_group = st.st_gid == 0 or group in PRIVILEGED_GROUPS
        severity = "critical" if privileged_group else "high"
        finding = make_finding(
            severity, "sgid", f"writable SGID binary: {path}",
            f"owner {owner}, group {group}, mode {mode} - writable by the current user",
            "high",
            file_evidence(path, st, "sgid", suid_complete,
                          writable=True, functions=[]),
            functions=[],
        )
        finding["evidence"].update({
            "risk": (f"Anyone who can write this file can replace it and execute code with "
                     f"the privileges of group {group}. SGID is not root unless the group "
                     "is privileged."),
            "limitations": ("Writability was observed; the file was not modified or executed. "
                            "GTFOBins has no SGID contexts, so no snippet is correlated."),
            "remediation": (f"Remove the SGID bit (chmod g-s {path}), correct its ownership "
                            "and mode, and investigate how it became writable."),
        })
        findings.append(finding)

    for path, have in sorted(caps["caps"].items()):
        try:
            st = os.lstat(path)
        except OSError:
            cap_stat_errors += 1
            continue
        writable = writable_by_us(st.st_mode, os.geteuid(), os.access(path, os.W_OK))
        key, funcs = matching(db, path, "capabilities", have)
        names = [name for name, _ in funcs]
        cap_list = sorted(have)
        if writable:
            severity = "critical" if st.st_uid == 0 else "high"
            owner = _id_name(lambda uid: pwd.getpwuid(uid).pw_name, st.st_uid, st.st_uid)
            finding = make_finding(
                severity, "capabilities", f"writable binary with capabilities: {path}",
                f"owner {owner}, capabilities {', '.join(cap_list)} - writable by the current user",
                "high",
                file_evidence(path, st, "capabilities", cap_status == "complete",
                              writable=True, capabilities=cap_list, functions=names),
                functions=[{"name": name,
                            "code": rewrite_commands(code, key, path)}
                           for name, code in funcs],
            )
            finding["evidence"].update({
                "risk": ("Anyone who can write this file can replace it and inherit its "
                         "file capabilities."),
                "limitations": ("Writability was observed; the file was not modified or executed. "
                                "The capability effect was not tested."),
                "remediation": (f"Remove the file capabilities (setcap -r {path}) or restore "
                                "root-owned mode 0755; investigate how it became writable."),
            })
            findings.append(finding)
            continue
        if not key or not funcs:
            continue
        severity = "high" if any(name in SERIOUS for name in names) else "medium"
        finding = make_finding(
            severity, "capabilities", f"capabilities {path}",
            ", ".join(cap_list),
            "medium",
            file_evidence(path, st, "capabilities", cap_status == "complete",
                          writable=False, capabilities=cap_list, functions=names),
            functions=[{"name": name,
                        "code": rewrite_commands(code, key, path)}
                       for name, code in funcs],
        )
        finding["evidence"].update({
            "risk": ("The binary retains file capabilities that, combined with a documented "
                     "GTFOBins function, may provide elevated access."),
            "limitations": ("Capability presence does not prove exploitability; the version, "
                            "configuration and snippet were not tested."),
            "remediation": ("Remove unnecessary capabilities (setcap -r PATH), use the least "
                            "privilege required, and prefer systemd/ambient capabilities."),
        })
        findings.append(finding)

    if cap_stat_errors:
        if cap_status == "complete":
            cap_status = "partial"
        cap_reason = "; ".join(filter(None, [cap_reason,
                                             f"could not stat {cap_stat_errors} result(s)"]))
        notes.append(f"capabilities: could not stat {cap_stat_errors} result(s)")
        for finding in findings:
            if finding["vector"] == "capabilities":
                finding["evidence"]["scan_complete"] = False

    notes = list(dict.fromkeys(notes))
    checks = {
        "sudo": {"status": sudo["status"], "reason": sudo["error"],
                 "count": len(sudo["rules"])},
        "suid": {"status": privileged["status"], "reason": privileged["reason"],
                 "count": len(suid)},
        "sgid": {"status": privileged["status"], "reason": privileged["reason"],
                 "count": len(sgid),
                 "note": "GTFOBins has no SGID contexts; only writable SGID files are reported."},
        "capabilities": {"status": cap_status, "reason": cap_reason,
                         "count": len(caps["caps"])},
    }
    coverage = {
        "complete": all(check["status"] in ("complete", "unsupported")
                        for check in checks.values()),
        "checks": checks,
    }

    findings.sort(key=lambda f: (SEVERITY[f["severity"]], CONFIDENCE[f["confidence"]],
                                 f["vector"], f["title"]))
    elapsed = time.time() - started
    exit_code = check_exit_code(findings, fail_on)
    if privileged["status"] in ("unavailable", "failed"):
        exit_code = EXIT_ERROR

    if as_json:
        payload = {
            "version": VERSION,
            "schema_version": SCHEMA_VERSION,
            "platform": sys.platform,
            "user": _id_name(lambda uid: pwd.getpwuid(uid).pw_name, os.getuid(), os.getuid()),
            "elapsed": round(elapsed, 2),
            "tested": {
                "suid": len(suid), "sgid": len(sgid),
                "capabilities": len(caps["caps"]), "sudo": sudo["ok"],
                "suid_complete": suid_complete, "sgid_complete": suid_complete,
                "capabilities_checked": cap_status == "complete",
            },
            "coverage": coverage,
            "findings": findings,
            "notes": notes,
        }
        print(json.dumps(payload, indent=2))
        return exit_code

    user = _id_name(lambda uid: pwd.getpwuid(uid).pw_name, os.getuid(), os.getuid())
    print(bold("Escabin local check") + dim(
        f"  {sys.platform}  user={safe_text(user)}  {elapsed:.1f}s"))
    print(dim("checks: " + safe_text(coverage_summary(coverage))))
    print(dim("coverage: " + ("complete" if coverage["complete"]
                              else "incomplete (see notes)")))

    if not findings:
        print()
        if coverage["complete"]:
            print(green("scan complete: no GTFOBins privilege-escalation vector found"))
        else:
            print(yellow("no vector found in the checks that completed; coverage is incomplete"))
        for note in notes:
            print(dim("  note: " + safe_text(note)))
        if unknown:
            print(dim(f"  note: {len(unknown)} SUID binaries have no GTFOBins entry"))
        return exit_code

    colors = {"critical": red, "high": yellow, "medium": cyan}
    for finding in findings:
        print()
        print(f"{colors[finding['severity']](finding['severity'].upper()):<10} "
              f"{bold(safe_text(finding['title']))}")
        meta = (f"{finding['confidence']} confidence; "
                "exploitability unverified")
        if finding["manual_review"]:
            meta += "; manual review"
        print(dim("          " + meta))
        if finding["detail"]:
            print(dim("          " + safe_text(finding["detail"])))
        if finding["evidence"]:
            print(dim("          evidence: " + safe_text(evidence_summary(finding))))
        if finding["command"]:
            print("          $ " + safe_text(finding["command"]))
        for fn in finding["functions"]:
            print("          " + cyan(safe_text(fn["name"])))
            for line in fn["code"].splitlines():
                print("          $ " + safe_text(line))
        for label in ("risk", "limitations", "remediation"):
            if finding["evidence"].get(label):
                print(dim(f"          {label}: " + safe_text(finding["evidence"][label])))

    if unknown:
        print()
        shown = ", ".join(safe_text(path) for path in unknown[:6])
        print(dim(f"note: {len(unknown)} SUID binaries have no GTFOBins entry" +
                  (": " + shown + (" ..." if len(unknown) > 6 else ""))))
    for note in notes:
        print(dim("note: " + safe_text(note)))
    print()
    print(dim("hint: `escabin <binary>` shows every documented trick for a binary"))
    return exit_code


# ---------------------------------------------------------------- cli

def main():
    argv = sys.argv[1:]
    commands = {"show", "search", "check", "update", "list"}
    if argv and not argv[0].startswith("-") and argv[0] not in commands:
        argv = ["show"] + argv

    parser = argparse.ArgumentParser(
        prog="escabin",
        description="Offline GTFOBins lookup and local privilege-escalation audit.",
    )
    parser.add_argument("--version", action="version", version=f"escabin {VERSION}")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_show = sub.add_parser("show", help="show every documented trick for a binary")
    p_show.add_argument("binary")

    p_search = sub.add_parser("search", help="search binaries, functions, commands and comments")
    p_search.add_argument("term")
    p_search.add_argument("-n", type=int, default=40, help="max results (default 40)")

    p_check = sub.add_parser("check", help="audit this machine against GTFOBins")
    p_check.add_argument("--full", action="store_true", help="scan the whole filesystem (slow)")
    p_check.add_argument("--ask-sudo", action="store_true", help="allow sudo to prompt for a password")
    p_check.add_argument("--json", action="store_true", help="machine-readable output")
    p_check.add_argument(
        "--fail-on", choices=("critical", "high", "medium"),
        help="exit 3 if a finding at or above this severity exists (default: 0)",
    )

    sub.add_parser("update", help="download the latest GTFOBins data")
    sub.add_parser("list", help="list all documented binaries")

    args = parser.parse_args(argv)

    if args.cmd == "update":
        db = DB(load_api(refresh=True))
        print(f"{len(db.ex)} binaries indexed")
        return

    db = DB(load_api())

    if args.cmd == "show":
        cmd_show(db, args.binary)
    elif args.cmd == "search":
        cmd_search(db, args.term, args.n)
    elif args.cmd == "check":
        sys.exit(cmd_check(db, args.full, args.json, args.ask_sudo, args.fail_on))
    elif args.cmd == "list":
        for name in sorted(db.ex):
            print(safe_text(name))
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
