}

TTY = sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def paint(text, code):
    return f"\033[{code}m{text}\033[0m" if TTY else str(text)


def bold(t):
    return paint(t, "1")


def dim(t):
    return paint(t, "2")


def red(t):
    return paint(t, "1;31")


def yellow(t):
    return paint(t, "1;33")


def cyan(t):
    return paint(t, "1;36")


def green(t):
    return paint(t, "1;32")


def die(msg):
    print(f"escabin: {safe_text(msg)}", file=sys.stderr)
    sys.exit(EXIT_ERROR)


_UNSAFE = re.compile(
    r"[\x00-\x1f\x7f-\x9f\u202a-\u202e\u2066-\u2069\ud800-\udfff]"
)


def safe_text(value):
    """Make system-provided text safe for a terminal (control chars/ANSI/bidi)."""
    def repl(match):
        code = ord(match.group(0))
        return f"\\x{code:02x}" if code <= 0xff else f"\\u{code:04x}"
    return _UNSAFE.sub(repl, str(value))


def clean_md(text):
    text = (text or "").replace("`", "")
    text = re.sub(r"\[([^\]]+)\]\(([^)]+)\)", r"\1 (\2)", text)
    return text.strip()


def system_tool(name):
    """Resolve audit tools from system dirs, not from PATH."""
    for directory in TOOL_DIRS:
        path = os.path.join(directory, name)
        if os.access(path, os.X_OK):
            return path
    return shutil.which(name)


# ---------------------------------------------------------------- data

def _type_name(value):
    return type(value).__name__


def _check_str_list(value, where):
    if isinstance(value, str):
        return
    if isinstance(value, list) and all(isinstance(item, str) for item in value):
        return
    raise ValueError(f"{where} must be a string or a list of strings")


def validate_api(data):
    """Reject malformed data before it can replace a working cache."""
    if not isinstance(data, dict):
        raise ValueError("top level must be a JSON object")
    for key in ("executables", "functions", "contexts"):
        if key not in data:
            raise ValueError(f"missing {key!r}")
        if not isinstance(data[key], dict):
            raise ValueError(f"{key!r} must be an object, got {_type_name(data[key])}")
    if not data["executables"]:
        raise ValueError("'executables' is empty")

    for name, entry in data["executables"].items():
        if not isinstance(name, str) or not name:
            raise ValueError("executable names must be non-empty strings")
        if not isinstance(entry, dict):
            raise ValueError(f"executables[{name!r}] must be an object")
        alias = entry.get("alias")
        if alias is not None:
            _check_str_list(alias, f"executables[{name!r}].alias")
        if entry.get("comment") is not None and not isinstance(entry["comment"], str):
            raise ValueError(f"executables[{name!r}].comment must be a string")
        funcs = entry.get("functions")
        if funcs is None:
            continue
        if not isinstance(funcs, dict):
            raise ValueError(f"executables[{name!r}].functions must be an object")
        for func, items in funcs.items():
            if not isinstance(func, str) or not isinstance(items, list):
                raise ValueError(f"executables[{name!r}].functions[{func!r}] must be a list")
            for index, item in enumerate(items):
                where = f"executables[{name!r}].functions[{func!r}][{index}]"
                if not isinstance(item, dict):
                    raise ValueError(f"{where} must be an object")
                if item.get("code") is not None and not isinstance(item["code"], str):
                    raise ValueError(f"{where}.code must be a string")
                if item.get("comment") is not None and not isinstance(item["comment"], str):
                    raise ValueError(f"{where}.comment must be a string")
                contexts = item.get("contexts")
                if contexts is None:
                    continue
                if not isinstance(contexts, dict):
                    raise ValueError(f"{where}.contexts must be an object")
                for ctx, override in contexts.items():
                    if not isinstance(ctx, str):
                        raise ValueError(f"{where}.contexts keys must be strings")
                    if override is None:
                        continue
                    if not isinstance(override, dict):
                        raise ValueError(f"{where}.contexts[{ctx!r}] must be an object or null")
                    if override.get("code") is not None and not isinstance(override["code"], str):
                        raise ValueError(f"{where}.contexts[{ctx!r}].code must be a string")
                    if override.get("list") is not None:
                        _check_str_list(override["list"], f"{where}.contexts[{ctx!r}].list")

    for func, entry in data["functions"].items():
        if not isinstance(func, str) or not isinstance(entry, dict):
            raise ValueError("'functions' values must be objects")
        if entry.get("label") is not None and not isinstance(entry["label"], str):
            raise ValueError(f"functions[{func!r}].label must be a string")
    for ctx, entry in data["contexts"].items():
        if not isinstance(ctx, str) or not isinstance(entry, dict):
            raise ValueError("'contexts' values must be objects")


def _read_limited(resp):
    headers = getattr(resp, "headers", None)
    length = headers.get("Content-Length") if headers else None
    if length:
        try:
            declared = int(length)
        except (TypeError, ValueError):
            declared = None
        if declared is not None and declared > MAX_DOWNLOAD:
            raise ValueError(f"response is larger than {MAX_DOWNLOAD} bytes")
    chunks = []
    total = 0
    while True:
        chunk = resp.read(65536)
        if not chunk:
            break
        total += len(chunk)
        if total > MAX_DOWNLOAD:
            raise ValueError(f"response is larger than {MAX_DOWNLOAD} bytes")
        chunks.append(chunk)
    return b"".join(chunks)


def download(path=None, url=API_URL):
    """Download and validate data, then atomically replace the cache."""
    path = path or API_PATH
    directory = os.path.dirname(path) or "."
    os.makedirs(directory, exist_ok=True)
    req = urllib.request.Request(url, headers={"User-Agent": f"escabin/{VERSION}"})
    try:
        with urllib.request.urlopen(req, timeout=HTTP_TIMEOUT) as resp:
            raw = _read_limited(resp)
    except urllib.error.HTTPError as exc:
        raise ValueError(f"HTTP {exc.code} from {url}") from exc
    except urllib.error.URLError as exc:
        raise ValueError(f"cannot reach {url}: {exc.reason}") from exc
    except (OSError, ValueError) as exc:
        if isinstance(exc, ValueError) and "larger than" in str(exc):
            raise
        raise ValueError(f"download failed: {exc}") from exc
    if not raw:
        raise ValueError("empty response")
    try:
        data = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError, RecursionError) as exc:
        raise ValueError(f"invalid JSON: {exc}") from exc
    validate_api(data)

    digest = hashlib.sha256(raw).hexdigest()
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".api.", suffix=".tmp")
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(raw)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)
    return len(raw), digest


def load_api(refresh=False, path=None):
    path = path or API_PATH
    if refresh:
        try:
            size, digest = download(path=path)
        except (ValueError, OSError) as exc:
            die(f"update failed: {exc}; existing cache left unchanged")
        print(f"updated {safe_text(path)} ({size / 1024:.0f} KiB, sha256 {digest})")
    if not os.path.exists(path):
        try:
            download(path=path)
        except (ValueError, OSError) as exc:
            die(f"no local data and download failed: {exc}")
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
        validate_api(data)
    except (OSError, ValueError, RecursionError) as exc:
        die(f"cannot use data file {path}: {exc}; run: escabin update")
    return data


class DB:
    def __init__(self, data):
        self.data = data
        self.ex = data["executables"]
        self.aliases = {}
        for name, entry in self.ex.items():
            alias = entry.get("alias")
            for a in [alias] if isinstance(alias, str) else (alias or []):
                self.aliases.setdefault(a, name)

    def canon(self, ref):
        name = os.path.basename(ref.rstrip("/")) or ref
        stripped = re.sub(r"-?\d+(\.\d+)*$", "", name)
        for cand in (name, stripped):
            if not cand:
                continue
            for _ in range(4):
                if cand in self.ex:
                    entry = self.ex[cand]
                    if not entry.get("functions") and isinstance(entry.get("alias"), str):
                        cand = entry["alias"]
                        continue
                    return cand
                if cand in self.aliases:
                    cand = self.aliases[cand]
                    continue
                break
        return None

    def funcs(self, name):
        return (self.ex.get(name) or {}).get("functions") or {}

    def ordered(self, funcs):
        return sorted(funcs, key=lambda f: (FUNC_ORDER.index(f) if f in FUNC_ORDER else 99, f))

    def label(self, func):
        return (self.data["functions"].get(func) or {}).get("label", func)


def context_code(item, ctx):
    over = (item.get("contexts") or {}).get(ctx)
    if isinstance(over, dict) and over.get("code"):
        return over["code"]
    return item.get("code")


def context_caps(item, ctx):
    over = (item.get("contexts") or {}).get(ctx)
    if isinstance(over, dict) and over.get("list"):
        need = over["list"]
        return [need] if isinstance(need, str) else list(need)
    return None


SHELL_META = "|;&()<>"
SHELL_KEYWORDS = {"if", "then", "elif", "else", "while", "until", "do", "!",
                  "time", "exec", "command", "env", "nohup"}


def rewrite_commands(code, binary, path, prefix=""):
    """Rewrite every command-position use of `binary` to `path`, optionally sudo-prefixed."""
    names = {binary, os.path.basename(path)}
    target = shlex.quote(path)
    return "\n".join(_rewrite_line(line, names, target, prefix)
                     for line in (code or "").splitlines())


def _rewrite_line(line, names, path, prefix):
    out = []
    i, n = 0, len(line)
    quote = None
    cmd_pos = True
    while i < n:
        ch = line[i]
        if quote:
            out.append(ch)
            if ch == "\\" and quote == '"' and i + 1 < n:
                out.append(line[i + 1])
                i += 2
                continue
            if ch == quote:
                quote = None
            i += 1
            continue
        if ch == "\\" and i + 1 < n:
            out.append(line[i:i + 2])
            i += 2
            continue
        if ch in "'\"":
            quote = ch
            out.append(ch)
            i += 1
            continue
        if ch in " \t":
            out.append(ch)
            i += 1
            continue
        if ch in SHELL_META:
            out.append(ch)
            if i + 1 < n and line[i + 1] == ch and ch in "|&":
                out.append(ch)
                i += 1
            if ch in "|;&(":
                cmd_pos = True
            i += 1
            continue

        start = i
        j = i
        if cmd_pos:
            while True:
                env = re.match(
                    r"[A-Za-z_][A-Za-z0-9_]*=(?:'[^']*'|\"[^\"]*\"|[^\s;|&()<>]+)[ \t]*",
                    line[j:],
                )
                if not env:
                    break
                j += env.end()
        k = j
        while k < n and line[k] not in " \t" + SHELL_META:
            k += 1
        word = line[j:k]
        if cmd_pos and word in names:
            out.append(prefix + line[start:j] + path)
            i = k
            cmd_pos = False
            continue
        out.append(line[start:k])
        i = k
        cmd_pos = cmd_pos and word in SHELL_KEYWORDS
    return "".join(out)


def print_code(code, indent="    "):
    for line in (code or "").rstrip().splitlines():
        print(indent + safe_text(line))


